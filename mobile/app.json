{
  "expo": {
    "name": "Starpix",
    "slug": "starpix",
    "owner": "talkmingo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "starpix",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.starpix.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.starpix.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-video",
      "expo-audio",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Starpix to access and save created posters and videos to your gallery.",
          "savePhotosPermission": "Allow Starpix to save your festival posters and videos to your device gallery."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Starpix needs access to your photos so you can select profile photos and business logos for posters."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c69a468-1d14-4f95-8622-55ceecc93e15"
      }
    }
  }
}
