{
  "expo": {
    "name": "Starpix",
    "slug": "starpix",
    "owner": "talkmingo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "starpix",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07140B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.starpix.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#140F0B"
      },
      "package": "com.starpix.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c69a468-1d14-4f95-8622-55ceecc93e15"
      }
    }
  }
}
